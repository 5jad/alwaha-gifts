# Environment Variables & Secrets for Cloudflare Worker
# Copy this file to .dev.vars for local development (wrangler dev)
# In production, set secrets using: wrangler secret put <KEY>

# Admin Dashboard Authentication (Required: fail closed if not set)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="a-very-strong-and-random-password-here"
ADMIN_SESSION_SECRET="64-char-random-hex-for-hmac-sha256-session-signing"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
TELEGRAM_CHAT_ID="-1001234567890"

# Google Sheets Webhook (Apps Script Web App - Optional)
SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec"
SHEETS_SECRET="super-secret-random-token-here"

# Meta Pixel & Conversions API (CAPI)
META_PIXEL_ID="1234567890123456"
META_CAPI_ACCESS_TOKEN="EAAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
META_API_VERSION="v21.0"
META_CURRENCY="USD"
USD_RATE="1520"
PAYMENT_COMMISSION_PERCENT="0"
# Optional Meta Test Event Code (e.g. TEST12345) to see events in Events Manager > Test Events
META_TEST_EVENT_CODE=""

# Cloudflare Turnstile (Optional - leave empty to bypass)
TURNSTILE_SECRET=""
VITE_TURNSTILE_SITE_KEY=""

# Public environment variable for Vite build
# VITE_META_PIXEL_ID="1234567890123456"
